{
  "manifest_version": 3,
  "name": "Backdrop",
  "version": "1.0.0",
  "description": "Make every new tab a calm background from your own collection: search free photos or upload your own.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Backdrop" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://api.openverse.org/*"]
}
